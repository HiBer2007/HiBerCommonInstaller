{
  "id": "install",
  "steps": [
    { "id": "welcome", "ui": "welcome" },
    { "id": "license", "ui": "license", "source": "LICENSE.txt" },
    { "id": "components", "ui": "components" },
    { "id": "extract", "type": "extract", "source": "dir:payload", "target": "{installDir}" },
    { "id": "editorNote", "type": "demo_ping", "note": "editor selected",
      "when": "vars['components.editor'] == 'true'" },
    { "id": "pingReport", "type": "script",
      "script": "if vars.demoPing == 'true' then print('[demo] custom step demo_ping executed') end" },
    { "id": "editorCheck", "type": "script",
      "script": "if vars['components.editor'] == 'true' then print('[demo] editor component selected') end" },
    { "id": "writeconf", "type": "template", "target": "{installDir}",
      "file": "install.conf",
      "header": "# DemoApp Install Configuration",
      "template": {
        "install_path": "{installDir}",
        "install_editor": "{components.editor}",
        "app_version": "{productVersion}"
      } },
    { "id": "finish", "ui": "finish", "message": "DemoApp installed successfully" }
  ]
}